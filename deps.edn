{:paths ["src"]
 :deps {io.github.kotoba-lang/io-multiformats      {:git/sha "37843825a77bc6b74f4a1882471d252f6f931f58"}
        io.github.kotoba-lang/org-ietf-cbor        {:git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/io-ipld              {:git/sha "e08dc3b2ab705be292e388cd1ad136381544a041"}
        io.github.kotoba-lang/arrangement          {:git/sha "42803e81bba695811c5403dbe2517770d08482e1"}
        io.github.kotoba-lang/chain                {:git/sha "f8f6db8bf8c689063d43297cbe6c06383cc6c3b6"}
        io.github.kotoba-lang/org-ietf-ed25519     {:git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        io.github.kotoba-lang/org-chainagnostic-cacao {:git/sha "3aaab02fb993a1d0b716c8fc1aefe37e4e3ab850"}}
 :aliases
 {;; same-monorepo dev: clojure -M:local:test (mirrors org-chainagnostic-cacao's pattern)
  :local {:override-deps {io.github.kotoba-lang/io-multiformats  {:local/root "../io-multiformats"}
                           io.github.kotoba-lang/org-ietf-cbor   {:local/root "../org-ietf-cbor"}
                           io.github.kotoba-lang/io-ipld         {:local/root "../io-ipld"}
                           io.github.kotoba-lang/arrangement     {:local/root "../arrangement"}
                           io.github.kotoba-lang/chain           {:local/root "../chain"}
                           io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org-ietf-ed25519"}
                           io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../org-chainagnostic-cacao"}}}
  ;; Real-ClojureScript host for nekko.key-journal's suite, which nbb cannot
  ;; run (chain.core's non-genesis commits encode `prev` as an ipld deftype,
  ;; whose field sci cannot read). Works off the git pins above -- it used to
  ;; need :local because those pins were stale enough that cljs rejected them;
  ;; they were bumped instead. See test/nekko/cljs_test_runner.cljs.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
