{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-multiformats      {:git/sha "bbddb14908d39999a2523979ad9f5d46ec8a612d"}
        io.github.kotoba-lang/org-ietf-cbor        {:git/sha "cf2066f8dfa67a2934365519745231b4f1673a1a"}
        io.github.kotoba-lang/io-ipld              {:git/sha "f99bf27d58a75bb8cf6ddfd2d57a0aaac9c824ac"}
        io.github.kotoba-lang/arrangement          {:git/sha "d1ef17edf4ac870b1e792bce9e6fe98e9eb96f7f"}
        io.github.kotoba-lang/chain                {:git/sha "5545426442ddacc919836fe2e17936684529895b"}
        io.github.kotoba-lang/org-ietf-ed25519     {:git/sha "6117bf17fceef4f95e33e6db2e0daa25553c0f0e"}
        io.github.kotoba-lang/org-chainagnostic-cacao {:git/sha "c70ba68f39c850f53cb20d1ac4915b1924d580f9"}}
 :aliases
 {;; same-monorepo dev: kbb -M:local:test (mirrors org-chainagnostic-cacao's pattern)
  :local {:override-deps {io.github.kotoba-lang/io-multiformats  {:local/root "../io-multiformats"}
                           io.github.kotoba-lang/org-ietf-cbor   {:local/root "../org-ietf-cbor"}
                           io.github.kotoba-lang/io-ipld         {:local/root "../io-ipld"}
                           io.github.kotoba-lang/arrangement     {:local/root "../arrangement"}
                           io.github.kotoba-lang/chain           {:local/root "../chain"}
                           io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org-ietf-ed25519"}
                           io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../org-chainagnostic-cacao"}}}
  ;; Real-ClojureScript host for nekko.key-journal's suite, which nbb cannot
  ;; run (chain.core's non-genesis commits encode `prev` as an ipld deftype,
  ;; whose field sci cannot read). Works off the git pins above -- it used to
  ;; need :local because those pins were stale enough that cljs rejected them;
  ;; they were bumped instead. See test/nekko/cljs_test_runner.cljk.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
